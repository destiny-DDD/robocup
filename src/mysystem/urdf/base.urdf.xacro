<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="yuan.urdf.xacro"/>

    <xacro:macro name="base_xacro" params="x y z r">
        <link name="base_footprint"/>

        <link name="base_link">
            <xacro:box_visual x="${x}" y="${y}" z="${z}"/>
            <xacro:box_collision x="${x/2}" y="${y/2}" z="${z/2}"/>
            <xacro:box_inertia m="1.0" x="${x/2}" y="${y/2}" z="${z/2}"/>
        </link>

        <joint name="joint_first" type="fixed">
            <parent link="base_footprint"/>
            <child link="base_link"/>
            <origin xyz="0.0 0.0 ${r}" rpy="0.0 0.0 0.0"/>
        </joint>
    </xacro:macro>
</robot>
